---
source: partiql-beamline-query/tests/simple.rs
expression: queries
---
SELECT *
FROM test_data AS test_data
WHERE ((((((test_data.created_at <> UTCNOW())
          OR
          ((test_data.price > 32.86374064090276)
            AND
            NOT (test_data.country_code IN [
                'Censet.',
                'Audiebamus.',
                'Sit.',
                'Et.'
              ])))
        OR
        (test_data.* >= 20))
      OR
      (test_data.description = 'Qui omnino avocent.'))
    OR
    test_data.description IN [
        'Voluptatem. Ut enim.',
        'Ad.',
        'Altera prompta et.',
        'Qui blanditiis praesentium.',
        'Quod inciderint in.'
      ]) OR
  NOT (test_data.transaction_id IN [
      'Paene.',
      'Virtutibus dicta.',
      'Enim invenire.'
    ]))

SELECT *
FROM test_data AS test_data
WHERE (((test_data.* <= 43.85089837483024)
    AND
    ((test_data.created_at <> UTCNOW())
      OR
      NOT (test_data.test_address LIKE 'Quam gravis.')))
  OR
  ((test_data.* <> -32.71774177160309)
    OR
    (((test_data.* < -1)
        AND
        ((test_data.price = -3.3159459625196135)
          AND
          test_data.description LIKE 'Explicari.'))
      AND
      (test_data.price = 7.751876052900144))))

SELECT *
FROM test_data AS test_data
WHERE ((test_data.country_code IN [
        'Sint coniuncta.',
        'Existimant, quos.',
        'Habemus, quae percipitur.',
        'Multos alios in.'
      ] OR
    (test_data.completed <> false))
  OR
  (((test_data.marketplace_id <> 16)
      AND
      (test_data.test_address LIKE 'Quoniam, cum.'
        OR
        test_data.test_address IN [
            'Poetarum.',
            'Se et Consentinis.',
            'Quidem nulli.',
            'Dolemus angoribus.',
            'Esse.'
          ])) OR
    ((test_data.* <= -30.650429593187862)
      OR
      (test_data.completed IN [
            true,
            true,
            false
          ] AND
        ((test_data.country_code <> 'Quapropter si.')
          AND
          test_data.price IN [
              -9.841194400190098,
              -23.129177491605226
            ])))))

SELECT *
FROM test_data AS test_data
WHERE (((test_data.country_code LIKE 'Postulant in eo.'
      AND
      ((test_data.* >= false)
        AND
        ((test_data.description <> 'Vacuitate.')
          AND
          NOT (test_data.transaction_id IN [
              'Res vero.',
              'Est.',
              'Semper utens nihil.',
              'Esse.',
              'Quod.'
            ])))) OR
    NOT (test_data.test_address IN [
        'Potest. Sed.',
        'Ex aeterno.',
        'Illam.'
      ])) AND
  NOT (test_data.* IN [
      {
        'test_decimal': -14.90071600839881,
        'test_string': 'Conspectum.'
      },
      39.281039004349964,
      {
        'test_decimal': 20.51269346264796,
        'test_string': 'Alienus. Democritea.'
      },
      -30.29313164391198,
      20.188900713417283
    ]))

SELECT *
FROM test_data AS test_data
WHERE ((test_data.price > 46.93949301573326)
  OR
  (test_data.price IN [
        -31.89047822354056,
        -44.10099486573995,
        -9.053235555850478
      ] AND
    NOT (test_data.transaction_id IN [
        'Expetendis, quid.',
        'Si qua in.'
      ])))
